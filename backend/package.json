{
  "name": "conduit-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/server.ts",
    "start": "node dist/server.js",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --packages=external --alias:@conduit/core=../core/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --tsconfig tsconfig.json --test test/*.test.ts ../core/test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^1.19.19",
    "hono": "^4.13.18",
    "openai": "^7.57.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.6"
  }
}
